# Copy to .env in this directory (deploy/) and adjust before running
# "docker compose up".

# Public host name of the viewer. Its DNS record must point to this server,
# and ports 80 and 443 must be reachable from the Internet.
DOMAIN=giscup26.mydomain.tld

# Address for Let's Encrypt notices (for example about expiring
# certificates).
LETSENCRYPT_EMAIL=admin@mydomain.tld

# 1 = use the Let's Encrypt staging environment for a first test. Its
# certificates are not trusted by browsers, but it has generous rate
# limits. Set back to 0 for the real certificate (see README).
LETSENCRYPT_STAGING=0

# User and group the viewer runs as. They need write access to
# data/cache on the host; "id -u" and "id -g" show your own.
APP_UID=1000
APP_GID=1000
